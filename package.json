{
  "name": "updownly",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "UPDOWNLY — a higher-or-lower trivia game built on thousands of real, source-backed facts.",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run data:validate && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "data:fetch": "tsx scripts/data/fetch.ts",
    "data:build": "tsx scripts/data/build.ts",
    "data:validate": "tsx scripts/data/validate.ts",
    "data:report": "tsx scripts/data/report.ts",
    "data:refresh": "npm run data:fetch && npm run data:build && npm run data:validate && npm run data:report",
    "icons": "tsx scripts/icons.ts",
    "screens": "playwright test --config playwright.screens.config.ts",
    "check": "npm run typecheck && npm run test && npm run data:validate && npm run build"
  },
  "dependencies": {
    "@preact/signals": "^2.11.3",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@phosphor-icons/core": "^2.1.1",
    "@playwright/test": "1.56.1",
    "@preact/preset-vite": "^2.10.6",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.11",
    "workbox-window": "^7.4.1"
  }
}
